{
  "name": "sbctl-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build && node scripts/check-production.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:generate": "openapi-typescript ../contracts/openapi.json -o src/api/generated/schema.d.ts",
    "api:check": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "7.0.6",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
