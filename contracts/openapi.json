  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sbctl_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "admin_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "csrf_token": {
            "type": "string"
          }
        },
        "required": [
          "admin_id",
          "display_name",
          "csrf_token"
        ]
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "login_name": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "login_name",
          "password"
        ]
      },
      "Quality": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "freshness": {
            "type": "string",
            "enum": [
              "current",
              "stale",
              "unknown"
            ]
          },
          "integrity_state": {
            "type": "string",
            "enum": [
              "ok",
              "counter_error",
              "state_lost"
            ]
          },
          "has_historical_gap": {
            "type": "boolean"
          },
          "gap_count": {
            "type": "integer",
            "minimum": 0
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "sampled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "synced_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "freshness",
          "integrity_state",
          "has_historical_gap",
          "gap_count",
          "started_at",
          "sampled_at",
          "synced_at"
        ]
      },
      "Node": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "management_address": {
            "type": "string"
          },
          "public_host": {
            "type": "string"
          },
          "protocols": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "AnyTLS",
                "TUIC v5"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "online",
              "degraded",
